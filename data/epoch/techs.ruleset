; ==========================================================================
; Epoch Slice 1 — future-age skeleton (2 anchors + Networked Computing + one
; leaf per future age). Establishes the Helix (IV) and Lattice (V) branches
; and the root_req hard gate. Prereqs are Slice-1 skeletal; Slices 2-3 replace
; the placeholder chains (e.g. Molecular Assembly's real reqs are Cultured
; Materials + Synthetic Cognition) with the full 28-tech graph from
; doc/design/epoch-tech-tree.md. Graphics reuse near existing icons until the
; art pass. Keep the age assignments in script.lua's EPOCH_TECH_AGE in sync.
; ==========================================================================

; Dynamo (III) gap-fill — bridge into the future ages.
[advance_networked_computing]
name     = _("Networked Computing")
class    = "Dynamo"
req1     = "Computers"
req2     = "Mass Production"
flags    = ""
graphic     = "a.computers"
graphic_alt = "-"

; Helix (IV) ANCHOR. Researchable via its prereqs (the doorway into age IV);
; it is the root_req carried by the rest of the Helix+Lattice subtree.
[advance_genome_cartography]
name     = _("Genome Cartography")
class    = "Helix"
req1     = "Genetic Engineering"
req2     = "Networked Computing"
flags    = ""
graphic     = "a.genetic_engineering"
graphic_alt = "-"

; Helix (IV) leaf. root_req = itself's parent anchor: this + everything that
; depends on it can only be acquired (by ANY means: research/theft/trade/free)
; once Genome Cartography is known. Seeds root_req inheritance into Lattice.
[advance_cellular_rewriting]
name     = _("Cellular Rewriting")
class    = "Helix"
req1     = "Genome Cartography"
req2     = "Medicine"
root_req = "Genome Cartography"
flags    = ""
graphic     = "a.genetic_engineering"
graphic_alt = "-"

; Lattice (V) ANCHOR. Canonical prereqs (wired in Slice 2 now that both exist).
; Both parents descend from Genome Cartography, so it INHERITS root_req =
; Genome Cartography automatically — no age-V tech without age IV's anchor.
[advance_molecular_assembly]
name     = _("Molecular Assembly")
class    = "Lattice"
req1     = "Cultured Materials"
req2     = "Synthetic Cognition"
flags    = ""
graphic     = "a.superconductors"
graphic_alt = "-"

; Lattice (V) leaf and the hard-gate test target: req1/req2 (Molecular Assembly
; + Superconductors) are both non-anchor techs, so the ONLY thing standing
; between a player and this tech (once those are held) is the INHERITED
; root_req = Genome Cartography. root_req here adds the age-V anchor gate too.
[advance_metamaterials]
name     = _("Metamaterials")
class    = "Lattice"
req1     = "Molecular Assembly"
req2     = "Superconductors"
root_req = "Molecular Assembly"
flags    = ""
graphic     = "a.superconductors"
graphic_alt = "-"

; ==========================================================================
; Epoch Slice 2 — full Helix age (IV). The 11 remaining Helix techs (Genome
; Cartography + Cellular Rewriting shipped in Slice 1). Real req1/req2 pairs
; per doc/design/epoch-tech-tree.md §4/§5.
;
; root_req strategy — enforce the age invariant ("no age-IV tech acquirable by
; ANY means without Genome Cartography"): explicit root_req = "Genome
; Cartography" goes on every Helix ENTRY node whose prereqs do not already
; carry the anchor's root_req, i.e. the direct GC children (Chimeric
; Agriculture, Cultured Materials) AND the two orphan lines whose prereqs are
; all pre-anchor Dynamo techs (Machine Cognition = Networked Computing +
; Robotics; Directed Energy = Laser + Fusion Power). Inheritance then stamps
; every downstream Helix/Lattice tech. (Corrects the design doc §5's guess of
; "at most Pressure Ecology, Orbital Logistics" — those inherit and need
; nothing; the real gaps are the Dynamo-rooted lines. Graphics reuse existing
; icons until the art pass.)
; ==========================================================================

; -- Bio / agriculture / materials fork (direct children of the anchor) --
[advance_chimeric_agriculture]
name     = _("Chimeric Agriculture")
class    = "Helix"
req1     = "Genome Cartography"
req2     = "Refrigeration"
root_req = "Genome Cartography"
flags    = ""
graphic     = "a.genetic_engineering"
graphic_alt = "-"

