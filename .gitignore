# Epoch — secrets and local overrides
.env
ops/observability/grafana/data/
ops/observability/data/

# Epoch — droplet: templates are tracked (*.example), but never commit the
# filled-in Caddyfile (holds the game password hash), the droplet's real IP/host,
# or any droplet-local secrets/notes. Keep operational specifics out of the
# public repo.
ops/droplet/Caddyfile
ops/droplet/*.secret
ops/droplet/*.local
ops/droplet/*.env

# Epoch — art pipeline intermediates
tools/art/output/
tools/art/*.tmp

# Epoch — generated tileset spritesheets (binaries, tracked separately via LFS if needed)
tileset/epoch/*.png

# Art readability-gate contact sheets (regenerable artifacts)
tileset/epoch/src/**/*_preview.png
